        "jsCode": "const body = $json.body || $json;\nconst headCommit = body.head_commit || {};\n\nconst repo_name = body.repository?.name || 'unknown-repo';\nconst repo_owner = body.repository?.owner?.login || body.repository?.owner?.name || 'unknown-owner';\nconst branch_ref = body.ref ? body.ref.replace('refs/heads/', '') : 'unknown-branch';\nconst commit_message = headCommit.message || 'No commit message';\nconst commit_author = headCommit.author?.username || headCommit.author?.name || 'unknown-author';\nconst commit_timestamp = headCommit.timestamp || new Date().toISOString();\n\nconst added = headCommit.added || [];\nconst modified = headCommit.modified || [];\nconst removed = headCommit.removed || [];\nconst modified_files = [...new Set([...added, ...modified, ...removed])];\n\nreturn {\n  repo_name,\n  repo_owner,\n  branch_ref,\n  commit_message,\n  commit_author,\n  commit_timestamp,\n  modified_files\n};"
