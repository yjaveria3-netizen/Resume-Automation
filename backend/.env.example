# Application Environment: development | production
ENV=development

# Database Connection (PostgreSQL in production; SQLite permitted in development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_updater

# Security Keys & Secrets
JWT_SECRET=replace_with_secure_random_jwt_secret_at_least_32_chars
JWT_ALGORITHM=HS256
ENCRYPTION_KEY=replace_with_valid_32_byte_urlsafe_base64_fernet_key
SERVICE_SECRET=replace_with_secure_service_to_service_secret

# AI & LLM Providers
GEMINI_API_KEY=replace_with_google_gemini_api_key

# GitHub OAuth Integration
GITHUB_CLIENT_ID=replace_with_github_oauth_client_id
GITHUB_CLIENT_SECRET=replace_with_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback
GITHUB_WEBHOOK_SECRET=replace_with_github_webhook_hmac_secret

# Frontend & CORS
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
STORAGE_DIR=backend/storage/resumes
